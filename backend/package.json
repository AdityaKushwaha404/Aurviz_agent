{
  "name": "aurviz-agent-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.js",
    "start": "node --env-file=.env src/index.js",
    "start:api": "ROLE=api node --env-file=.env src/index.js",
    "start:worker": "ROLE=worker node --env-file=.env src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "test": "node --test"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "connect-pg-simple": "10.0.0",
    "express": "5.1.0",
    "express-rate-limit": "8.7.4",
    "express-session": "1.18.2",
    "googleapis": "189.0.0",
    "helmet": "8.1.0",
    "pg": "8.16.3",
    "pg-boss": "12.38.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "prisma": "6.19.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.0",
      "effect": "^3.20.0"
    }
  }
}