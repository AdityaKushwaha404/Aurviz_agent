# Copy to .env locally. Never commit .env or production credentials.
NODE_ENV=development
ROLE=all
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
ANDROID_REDIRECT_URI=aurviz://oauth/callback
DATABASE_URL=postgresql://aurviz:replace-me@localhost:5432/aurviz?schema=public
SESSION_SECRET=replace-with-at-least-32-random-bytes
TOKEN_ENCRYPTION_KEY_B64=replace-with-base64-encoded-32-byte-key
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
ACCESS_TOKEN_TTL_DAYS=30
OAUTH_CODE_TTL_MINUTES=5
